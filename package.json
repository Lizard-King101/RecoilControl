{
  "name": "anti-recoil",
  "version": "0.3.0",
  "private": true,
  "description": "Windows recoil-control prototype with a testable input engine",
  "main": "build/desktop/main.js",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "firmware:build": "pio run --project-dir firmware && node scripts/firmware-release.cjs",
    "firmware:upload": "pio run --project-dir firmware --target upload",
    "board:check": "node scripts/board-check.cjs",
    "test:board-worker": "npm run build && electron tests/board-worker-smoke.cjs",
    "test:board-profile": "npm run build && node tests/board-profile-smoke.cjs",
    "build": "tsc",
    "prestart": "npm run build",
    "start": "electron .",
    "cli": "npm run build && node build/index.js",
    "serve": "npm run build && electron .",
    "serve:cli": "tsx watch src/index.ts",
    "doctor": "npm run build && node build/index.js --doctor",
    "demo": "npm run build && node build/index.js --demo",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:navigation-desktop": "npm run build && electron tests/navigation-desktop-smoke.cjs",
    "test:stances-desktop": "npm run build && electron tests/stance-desktop-smoke.cjs",
    "test:desktop": "npm run build && electron tests/desktop-smoke.cjs",
    "screenshots": "npm run build && electron scripts/screenshots.cjs",
    "typecheck": "tsc --noEmit",
    "test:attachments-desktop": "npm run build && electron tests/attachments-desktop-smoke.cjs",
    "test:vision-desktop": "npm run build && electron tests/vision-desktop-smoke.cjs",
    "library:serve": "npm run build && node scripts/library-server.cjs",
    "test:community-desktop": "npm run build && electron tests/community-desktop-smoke.cjs",
    "test:deletion-desktop": "npm run build && electron tests/deletion-desktop-smoke.cjs"
  },
  "dependencies": {
    "esptool-js": "0.7.0",
    "serialport": "13.0.0",
    "uiohook-napi": "1.5.5"
  },
  "optionalDependencies": {
    "node-interception": "2.0.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "45.2.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
